          <RadioButton x:Name="AppsNav" Style="{StaticResource Nav}" GroupName="Navigation" Tag="apps" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconApps}" Margin="0,0,13,0"/><TextBlock Text="Приложения" VerticalAlignment="Center" FontWeight="Medium"/></StackPanel></RadioButton>
          <RadioButton x:Name="SitesNav" Style="{StaticResource Nav}" GroupName="Navigation" Tag="sites" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconGlobe}" Margin="0,0,13,0"/><TextBlock Text="Сайты" VerticalAlignment="Center" FontWeight="Medium"/></StackPanel></RadioButton>
          <RadioButton x:Name="JournalNav" Style="{StaticResource Nav}" GroupName="Navigation" Tag="journal" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconJournal}" Margin="0,0,13,0"/><TextBlock Text="Журнал" VerticalAlignment="Center" FontWeight="Medium"/></StackPanel></RadioButton>
          <RadioButton x:Name="PreferencesNav" Style="{StaticResource Nav}" GroupName="Navigation" Tag="settings" Checked="Nav_Checked"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconSettings}" Margin="0,0,13,0"/><TextBlock Text="Настройки" VerticalAlignment="Center" FontWeight="Medium"/></StackPanel></RadioButton>
        </StackPanel><Canvas x:Name="NavRipples" IsHitTestVisible="False"/></Grid>
        <StackPanel Grid.Row="3" Margin="8,0,4,0">
          <Border x:Name="LocalBadge" Background="#1A9F9F9F" BorderBrush="#269F9F9F" BorderThickness="1" CornerRadius="14" Padding="12,9" Margin="0,0,0,16"><StackPanel Orientation="Horizontal"><Ellipse x:Name="LocalDot" Width="7" Height="7" Fill="#B5B5B5" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Text="Локально на вашем ПК" FontSize="11" Foreground="#D3D3D3" VerticalAlignment="Center"/></StackPanel></Border>
          <Button Click="Support_Click" ToolTip="Поддержать разработчика" FontSize="12" Padding="14,8" MinHeight="36" Margin="0,0,0,14"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconHeart}" Width="15" Height="15" Margin="0,0,8,0"/><TextBlock Text="Поддержать проект" VerticalAlignment="Center"/></StackPanel></Button>
          <StackPanel Orientation="Horizontal"><TextBlock x:Name="BrandVersion" Text="Relay 2.1" Foreground="#949494" FontSize="12" FontWeight="Medium"/><TextBlock x:Name="WhatsNewLink" Text="· что нового?" Foreground="#C4C4C4" FontSize="12" FontWeight="Medium" Margin="6,0,0,0" Cursor="Hand" ToolTip="Что изменилось в этой версии" MouseLeftButtonUp="WhatsNew_Click"/></StackPanel><TextBlock Text="Windows · sing-box 1.14.4" Foreground="#707070" FontSize="10" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
    </motion:LiquidGlass>

    <Grid Grid.Column="1" Margin="14,22,30,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="4,0,0,16"><StackPanel><TextBlock x:Name="PageTitle" Text="Подключение" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Один прокси для ваших приложений" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,5,0,0"/></StackPanel></Grid>
      <motion:LiquidGlass x:Name="StatusCard" Grid.Row="1" RenderTransformOrigin=".5,.5" CornerRadius="28" Background="#360B0B0B" Padding="24,20" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,22,0"><StackPanel Orientation="Horizontal"><motion:StatusGlyph x:Name="StatusIcon" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" AutomationProperties.Name="Состояние подключения"/><TextBlock x:Name="StatusText" Text="Готов к подключению" FontSize="19" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="StatusDetail" Text="Настройте прокси и выберите приложения." Foreground="#B6B6B6" FontSize="12.5" Margin="0,6,0,0"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Border Background="#1FFFFFFF" CornerRadius="11" Padding="10,4"><TextBlock x:Name="ProtocolPill" Text="SOCKS5" FontSize="10.5" FontWeight="Medium" Foreground="#D5D5D5"/></Border><Border Background="#1FFFFFFF" CornerRadius="11" Padding="10,4" Margin="7,0,0,0"><TextBlock x:Name="SelectedPill" Text="0 приложений" FontSize="10.5" FontWeight="Medium" Foreground="#D5D5D5"/></Border><Border x:Name="StatePillBorder" Background="#1FFFFFFF" CornerRadius="11" Padding="10,4" Margin="7,0,0,0"><TextBlock x:Name="StatePill" Text="Выключено" FontSize="10.5" FontWeight="Medium" Foreground="#D5D5D5"/></Border></StackPanel></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="ConnectButton" Content="Подключить приложения" Style="{StaticResource Primary}" MinWidth="220" Padding="22,12" Click="Connect_Click"/><Button x:Name="StopButton" Content="Отключить Chrome" Visibility="Collapsed" Margin="0,8,0,0" Click="Stop_Click"/></StackPanel>
        <Border x:Name="StatusSweep" Grid.ColumnSpan="2" Margin="-24,-20" CornerRadius="28" IsHitTestVisible="False"><Rectangle x:Name="SweepBand" Width="320" HorizontalAlignment="Left" Opacity="0"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#009F9F9F" Offset="0"/><GradientStop Color="#559F9F9F" Offset=".5"/><GradientStop Color="#009F9F9F" Offset="1"/></LinearGradientBrush></Rectangle.Fill><Rectangle.RenderTransform><TranslateTransform x:Name="SweepMove" X="-320"/></Rectangle.RenderTransform></Rectangle></Border>
        <Border x:Name="StatusGlow" Grid.ColumnSpan="2" Margin="-24,-20" CornerRadius="28" BorderThickness="1.8" BorderBrush="#00FFFFFF" IsHitTestVisible="False"/>
        <Canvas x:Name="StatusBubbles" Grid.ColumnSpan="2" Margin="-24,-20" IsHitTestVisible="False"/>
        <Border x:Name="StatusTrack" Grid.ColumnSpan="2" Margin="14,0,14,-18" Height="3" VerticalAlignment="Bottom" CornerRadius="2" ClipToBounds="True" Opacity="0" IsHitTestVisible="False" Background="#22FFFFFF"><Border x:Name="StatusBar" Width="150" HorizontalAlignment="Left" CornerRadius="2"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00999999"/><GradientStop Color="#FFCACACA" Offset=".5"/><GradientStop Color="#00999999" Offset="1"/></LinearGradientBrush></Border.Background><Border.RenderTransform><TranslateTransform x:Name="BarMove" X="-150"/></Border.RenderTransform></Border></Border>
      </Grid></motion:LiquidGlass>
      <Grid Grid.Row="2" x:Name="SettingsPanel">
        <Grid x:Name="ProxyPage"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <motion:LiquidGlass Style="{StaticResource Card}"><DockPanel><Grid DockPanel.Dock="Bottom" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="TestButton" Content="Проверить прокси" Click="Test_Click"/><Button Grid.Column="2" Content="Сохранить" Click="Save_Click" MinWidth="120"/></Grid><ScrollViewer motion:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><Grid Margin="0,0,0,22"><TextBlock Text="Прокси-сервер" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Padding="14,7" FontSize="12" MinHeight="34" Click="Paste_Click" ToolTip="Вставить адрес или ссылку из буфера обмена"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconClipboard}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Вставить ссылку" VerticalAlignment="Center"/></StackPanel></Button></Grid><TextBlock Text="Протокол" Style="{StaticResource Caption}"/><ComboBox x:Name="ProtocolBox" SelectedIndex="3" SelectionChanged="Protocol_Changed"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="HTTPS"/><ComboBoxItem Content="SOCKS4"/><ComboBoxItem Content="SOCKS5"/></ComboBox>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Адрес сервера" Style="{StaticResource Caption}"/><TextBox x:Name="HostBox" ToolTip="IP-адрес или домен. При вставке IP:порт порт перенесётся автоматически." DataObject.Pasting="Host_Pasting" LostKeyboardFocus="Host_LostFocus"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Порт" Style="{StaticResource Caption}"/><TextBox x:Name="PortBox" Text="1080"/></StackPanel></Grid>
            <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Логин" Style="{StaticResource Caption}"/><TextBox x:Name="UsernameBox"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Пароль" Style="{StaticResource Caption}"/><PasswordBox x:Name="PasswordInput"/></StackPanel></Grid>
            <StackPanel x:Name="TlsPanel" Visibility="Collapsed" Margin="0,18,0,0"><TextBlock Text="Имя сервера TLS" Style="{StaticResource Caption}"/><TextBox x:Name="TlsNameBox"/></StackPanel><TextBlock x:Name="ProtocolHint" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="2,16,0,0" LineHeight="17"/>
          </StackPanel></ScrollViewer></DockPanel></motion:LiquidGlass>
          <ScrollViewer Grid.Column="2" motion:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,0,2"><motion:LiquidGlass Style="{StaticResource Card}" Padding="22,20"><StackPanel><TextBlock Text="Маршрутизация" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/><CheckBox x:Name="DnsBox" Content="DNS через прокси" IsChecked="True"/><TextBlock Text="DNS через HTTPS для запросов, переданных в прокси. Системный DNS Windows не меняется." FontSize="11.5" Foreground="{StaticResource Muted}" Margin="31,2,0,12" LineHeight="16"/><CheckBox x:Name="UdpBox" Content="UDP через SOCKS5" IsChecked="True"/><TextBlock Text="Доступно, если ваш сервер поддерживает UDP." FontSize="11.5" Foreground="{StaticResource Muted}" Margin="31,2,0,0" LineHeight="16"/></StackPanel></motion:LiquidGlass><motion:LiquidGlass Style="{StaticResource Card}" Padding="22,20" Margin="0,16,0,0"><StackPanel><TextBlock Text="Быстрый старт" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="24" Height="24" CornerRadius="12" Background="#2ABABABA"><TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="#CBCBCB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Проверьте прокси" Foreground="#DBDBDB" FontSize="12.5" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Border Width="24" Height="24" CornerRadius="12" Background="#2ABABABA"><TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="#CBCBCB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Выберите приложения" Foreground="#DBDBDB" FontSize="12.5" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="12" Background="#2ABABABA"><TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="#CBCBCB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Включите подключение" Foreground="#DBDBDB" FontSize="12.5" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel>
            <Button Click="GoApps_Click" Margin="0,16,0,0" FontSize="12"><StackPanel Orientation="Horizontal"><TextBlock Text="К списку приложений" VerticalAlignment="Center"/><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconArrow}" Width="16" Height="16" Margin="9,0,0,0"/></StackPanel></Button></StackPanel></motion:LiquidGlass></StackPanel></ScrollViewer>
        </Grid>
        <Grid x:Name="AppsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Style="{StaticResource Primary}" Click="Add_Click" IsEnabled="{Binding CanEditApplications, RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconPlus}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Добавить .exe" VerticalAlignment="Center"/></StackPanel></Button><Button Content="Из запущенных" Click="Running_Click" IsEnabled="{Binding CanEditApplications, RelativeSource={RelativeSource AncestorType=Window}}" Margin="10,0,0,0"/><Button Click="Remove_Click" IsEnabled="{Binding CanEditApplications, RelativeSource={RelativeSource AncestorType=Window}}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconTrash}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Убрать" VerticalAlignment="Center"/></StackPanel></Button></StackPanel><Border Grid.Column="1" Background="#1F9F9F9F" CornerRadius="15" Padding="14,8" VerticalAlignment="Center"><TextBlock x:Name="CountText" Text="0 выбрано" Foreground="#C3C3C3" FontSize="12.5" FontWeight="Medium"/></Border></Grid><Grid Grid.Row="1" Margin="0,0,0,14"><TextBox x:Name="AppSearchBox" ToolTip="Поиск приложения по имени или пути" TextChanged="AppSearch_Changed" AutomationProperties.Name="Поиск приложения" Padding="42,11,14,11"/><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconSearch}" Width="18" Height="18" Foreground="#909090" HorizontalAlignment="Left" Margin="15,0,0,0"/><TextBlock Text="Поиск по имени или пути" Foreground="#909090" FontSize="13" Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=AppSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
          <Grid Grid.Row="2"><ListBox x:Name="AppsList" ItemsSource="{Binding Rules}" SelectionMode="Extended"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox IsEnabled="{Binding CanEditApplications, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,10,14,0" Checked="Rule_Changed" Unchecked="Rule_Changed" AutomationProperties.Name="Использовать прокси"/><Border Grid.Column="1" Background="#1AFFFFFF" Width="44" Height="44" CornerRadius="13" VerticalAlignment="Top" Margin="0,0,14,0"><Image Source="{Binding Path, Converter={StaticResource AppIcon}}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/></Border><StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,8" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Path}"/><CheckBox IsEnabled="{Binding CanEditApplications, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding IncludeHelpers, Mode=TwoWay}" Content="Включать вспомогательные .exe из папки приложения" FontSize="11.5" Margin="0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="30"><Border Width="84" Height="84" CornerRadius="28" Background="#1ABABABA" BorderBrush="#2EBABABA" BorderThickness="1" HorizontalAlignment="Center" RenderTransformOrigin=".5,.5"><Border.RenderTransform><TranslateTransform x:Name="EmptyFloat"/></Border.RenderTransform><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconApps}" Width="38" Height="38" Foreground="#CBCBCB" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitle" Text="Добавьте ваши приложения" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="Выберите .exe или найдите программу среди запущенных." Foreground="{StaticResource Muted}" FontSize="12.5" TextAlignment="Center"/></StackPanel></Grid>
          <Border Grid.Row="3" Background="#14FFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="20" Padding="18,12" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="После подключения перезапустите выбранные программы. Остальные приложения подключаются напрямую." Foreground="#B7B7B7" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,18,0"/><Button Grid.Column="1" Content="Открыть Chrome" Click="Chrome_Click" IsEnabled="{Binding CanEditApplications, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" Padding="16,8" MinHeight="36"/></Grid></Border>
        </Grid>
        <Grid x:Name="SitesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <motion:LiquidGlass Style="{StaticResource Card}" Padding="22,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Только указанные сайты" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="Работает во всех установленных браузерах (Chrome, Edge, Firefox, Яндекс и др.) — добавлять их в «Приложения» не нужно. Через прокси идут только сайты из списка, остальное напрямую. Программы из «Приложений» (Telegram и др.) идут через прокси целиком." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" LineHeight="17"/><TextBlock x:Name="SitesNotice" Text="Прокси выключен: список начнёт действовать после подключения. Изменения при включённом прокси применяются сами." Foreground="#E6E6E6" FontSize="12" Margin="0,8,0,0" LineHeight="17"/></StackPanel><CheckBox Grid.Column="1" x:Name="SitesOnlyBox" Style="{StaticResource Toggle}" Content="Только указанные сайты" IsEnabled="{Binding CanEditSites, RelativeSource={RelativeSource AncestorType=Window}}"/></Grid></motion:LiquidGlass>
          <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid><TextBox x:Name="SiteBox" Padding="42,11,14,11" KeyDown="SiteBox_KeyDown" TextChanged="SiteBox_TextChanged" AutomationProperties.Name="Адрес сайта" IsEnabled="{Binding CanEditSites, RelativeSource={RelativeSource AncestorType=Window}}"/><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconGlobe}" Width="18" Height="18" Foreground="#8A8A8A" HorizontalAlignment="Left" Margin="15,0,0,0"/><TextBlock Text="example.com — можно несколько через пробел" Foreground="#8A8A8A" FontSize="13" Margin="42,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SiteBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
            <Button Grid.Column="2" Style="{StaticResource Primary}" Click="SiteAdd_Click" IsEnabled="{Binding CanEditSites, RelativeSource={RelativeSource AncestorType=Window}}"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconPlus}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Добавить" VerticalAlignment="Center"/></StackPanel></Button></Grid>
          <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
