 Icon="relay.ico" Title="Relay — прокси для приложений" Width="1190" Height="820" MinWidth="980" MinHeight="700" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="#F1F1F1" FontFamily="{StaticResource UiFont}" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" Closing="Window_Closing" StateChanged="Window_StateChanged">
