        <Grid Grid.Row="1"><motion:LiquidGlass x:Name="NavigationLens" Height="45" VerticalAlignment="Top" CornerRadius="22" IsHitTestVisible="False" Background="#20FFFFFF" Margin="0,3,0,0"/><StackPanel>
