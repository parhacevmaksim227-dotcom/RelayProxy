              <ItemsControl x:Name="SuggestList" ItemsSource="{Binding Suggestions}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Style="{StaticResource Chip}" Tag="{Binding Domain}" Click="SuggestionAdd_Click" Margin="0,0,8,8" ToolTip="{Binding Reason}">
                    <StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="7" Background="#22FFFFFF" Margin="0,0,9,0"><Grid><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconGlobe}" Width="13" Height="13" Foreground="#C8C8C8"/><Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/></Grid></Border><TextBlock Text="{Binding Domain}" FontSize="12.5" VerticalAlignment="Center"/><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconPlus}" Width="13" Height="13" Margin="9,0,0,0" Foreground="#C8C8C8"/></StackPanel>
                  </Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
            <Grid Grid.Row="2"><ListBox x:Name="SitesList" ItemsSource="{Binding Sites}" SelectionMode="Single"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="11" Background="#1AFFFFFF" Margin="0,0,14,0"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconGlobe}" Width="18" Height="18" Foreground="#D8D8D8"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="14.5"/><TextBlock Text="и все поддомены" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/></StackPanel><Button Grid.Column="2" Style="{StaticResource WindowButton}" Tag="{Binding}" Click="SiteRemove_Click" ToolTip="Убрать сайт" IsEnabled="{Binding CanEditSites, RelativeSource={RelativeSource AncestorType=Window}}"><Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="None"/></Button></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <StackPanel x:Name="SitesEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="30"><Border Width="84" Height="84" CornerRadius="28" Background="#1AFFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1" HorizontalAlignment="Center"><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconGlobe}" Width="38" Height="38" Foreground="#E0E0E0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Добавьте сайты по домену" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="Например: example.com. Поддомены подключаются автоматически." Foreground="{StaticResource Muted}" FontSize="12.5" TextAlignment="Center"/></StackPanel></Grid></Grid>
        </Grid>
        <Grid x:Name="JournalPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Последние 200 событий" Foreground="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center" Margin="4,0,0,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Папка журнала" Click="OpenLog_Click" Padding="16,8" FontSize="12" MinHeight="36"/><Button Content="Очистить" Click="ClearLog_Click" Padding="16,8" Margin="10,0,0,0" FontSize="12" MinHeight="36"/></StackPanel></Grid><motion:LiquidGlass Grid.Row="1" Style="{StaticResource Card}" Background="#33111111" Padding="18"><TextBox x:Name="LogBox" Style="{StaticResource Plain}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></motion:LiquidGlass></Grid>
        <Grid x:Name="PreferencesPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer motion:SmoothScroll.Enabled="True" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><motion:LiquidGlass Style="{StaticResource Card}"><StackPanel><TextBlock Text="Запуск вместе с Windows" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Автозапуск Relay" FontWeight="SemiBold"/><TextBlock Text="При входе в Windows, с правами для перехвата процессов." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="AutoStartBox" Style="{StaticResource Toggle}" Content="Автозапуск Relay"/></Grid><Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Подключаться автоматически" FontWeight="SemiBold"/><TextBlock Text="Включать прокси для отмеченных приложений при каждом запуске Relay." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="AutoConnectBox" Style="{StaticResource Toggle}" Content="Подключаться автоматически"/></Grid><Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Запускать в трее" FontWeight="SemiBold"/><TextBlock Text="При автозапуске окно останется скрытым." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="StartHiddenBox" Style="{StaticResource Toggle}" Content="Запускать в трее"/></Grid><Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Права администратора без запроса" FontWeight="SemiBold"/><TextBlock Text="Windows спросит один раз, дальше Relay запускается с правами сам." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="AutoElevateBox" Style="{StaticResource Toggle}" Content="Права администратора без запроса"/></Grid></StackPanel></motion:LiquidGlass>
          <motion:LiquidGlass Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Окно и трей" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,20"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Сворачивать в трей" FontWeight="SemiBold"/><TextBlock Text="Кнопка свернуть убирает окно с панели задач." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="MinimizeTrayBox" Style="{StaticResource Toggle}" Content="Сворачивать в трей"/></Grid><Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Закрывать окно в трей" FontWeight="SemiBold"/><TextBlock Text="Крестик скрывает окно. Полный выход — через меню значка." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="CloseTrayBox" Style="{StaticResource Toggle}" Content="Закрывать окно в трей"/></Grid><Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,24,0"><TextBlock Text="Уменьшить анимации" FontWeight="SemiBold"/><TextBlock Text="Спокойные переходы без движения. Системная настройка Windows учитывается автоматически." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="ReduceMotionBox" Style="{StaticResource Toggle}" Content="Уменьшить анимации"/></Grid></StackPanel></motion:LiquidGlass>
          <motion:LiquidGlass Style="{StaticResource Card}" Margin="0,18,0,0"><StackPanel><TextBlock Text="Секретный код" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="Есть код? Введите его, и приложение сменит оформление. Повторный ввод вернёт обычный вид." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16" LineHeight="17"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid><TextBox x:Name="CodeBox" MaxLength="32" KeyDown="CodeBox_KeyDown" AutomationProperties.Name="Секретный код"/><TextBlock Text="Введите код" Foreground="#8A8A8A" FontSize="13" Margin="15,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CodeBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              <Button Grid.Column="2" Content="Применить" Style="{StaticResource Primary}" Click="ApplyCode_Click" MinWidth="130"/></Grid>
            <TextBlock x:Name="CodeResult" Foreground="{StaticResource Muted}" FontSize="12" Margin="2,12,0,0"/></StackPanel></motion:LiquidGlass></StackPanel></ScrollViewer><Grid Grid.Row="1" Margin="4,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PreferencesResult" Text="Изменения применяются после сохранения." Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Для первого включения автозапуска Windows может запросить права администратора." Foreground="#848484" FontSize="11" Margin="0,5,20,0"/></StackPanel><Button x:Name="SavePreferencesButton" Grid.Column="1" Content="Сохранить настройки" Style="{StaticResource Primary}" Click="SavePreferences_Click"/></Grid></Grid>
      </Grid>
      <Grid Grid.Row="3" Margin="4,12,0,0"><TextBlock Text="Пароль защищён Windows DPAPI" Foreground="#808080" FontSize="10.5"/><TextBlock Text="Двойной щелчок по значку в трее — открыть окно" HorizontalAlignment="Right" Foreground="#808080" FontSize="10.5"/></Grid>
    </Grid>

    <!-- A hairline rim so the rounded window edge reads against any desktop. -->
    <Border x:Name="WindowRim" Grid.ColumnSpan="2" CornerRadius="30" BorderThickness="1" BorderBrush="#30FFFFFF" IsHitTestVisible="False"/>

    <!-- Window controls, drawn in the app style because the system title bar is gone. -->
    <StackPanel Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,10,14,0" WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Свернуть"><Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="10" Height="10" Stretch="None"/></Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Развернуть"><Path x:Name="MaximizeGlyph" Data="M0.7,0.7 H9.3 V9.3 H0.7 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round" Width="10" Height="10" Stretch="None"/></Button>
      <Button Style="{StaticResource WindowButton}" Click="Close_Click" ToolTip="Закрыть"><Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="None"/></Button>
    </StackPanel>

    <!-- Sheets open inside the window rather than as separate windows. -->
    <Grid x:Name="NotesLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
      <Border x:Name="NotesScrim" Background="#B8000000" MouseLeftButtonDown="NotesScrim_Down"/>
      <motion:LiquidGlass x:Name="NotesCard" Margin="48,56,48,40" MaxWidth="720" MaxHeight="660" CornerRadius="32" Background="#44060606" Padding="28,26" RenderTransformOrigin=".5,.5">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Grid><TextBlock x:Name="NotesTitle" Text="Что нового?" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Content="Закрыть" Padding="18,8" FontSize="12" MinHeight="36" Click="NotesClose_Click"/></Grid>
          <ScrollViewer Grid.Row="1" Margin="0,20,0,0" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="NotesList" Margin="0,0,12,0"/></ScrollViewer>
        </Grid>
      </motion:LiquidGlass>
    </Grid>
    <Grid x:Name="PickerLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
      <Border x:Name="PickerScrim" Background="#B8000000" MouseLeftButtonDown="PickerScrim_Down"/>
      <motion:LiquidGlass x:Name="PickerCard" Margin="48,56,48,40" MaxWidth="800" MaxHeight="660" CornerRadius="32" Background="#44060606" Padding="28,26" RenderTransformOrigin=".5,.5">
        <motion:RunningAppsPanel x:Name="Picker"/>
      </motion:LiquidGlass>
    </Grid>
  </Grid>
</Window>
