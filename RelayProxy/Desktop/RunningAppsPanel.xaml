<UserControl x:Class="RelayProxy.Desktop.RunningAppsPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" TextElement.Foreground="#ECECEC" TextElement.FontSize="14">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="4,0,0,18"><TextBlock Text="Запущенные приложения" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Выберите программы, которые будут подключаться через прокси." Foreground="{StaticResource Muted}" Margin="0,6,0,0" FontSize="13"/></StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14"><TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="Поиск по имени или пути" AutomationProperties.Name="Поиск запущенного приложения" Padding="42,11,14,11"/><ContentControl Style="{StaticResource Icon}" Tag="{StaticResource IconSearch}" Width="18" Height="18" Foreground="#8A8A8A" HorizontalAlignment="Left" Margin="15,0,0,0"/></Grid>
    <Grid Grid.Row="2"><ListBox x:Name="ProcessList" SelectionMode="Extended" SelectionChanged="Selection_Changed" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="42" Height="42" CornerRadius="13" Background="#1AFFFFFF" HorizontalAlignment="Left"><Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold"/><TextBlock Text="{Binding Path}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox><TextBlock x:Name="Empty" Text="Загружаем приложения…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></Grid>
    <Grid Grid.Row="3" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Count" Text="Ctrl / Shift — выбрать несколько" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="4,0,0,0"/><Button Grid.Column="1" Content="Отмена" Click="Cancel_Click" Margin="12,0"/><Button Grid.Column="2" x:Name="AddButton" Content="Добавить выбранные" Style="{StaticResource Primary}" IsEnabled="False" Click="Add_Click"/></Grid>
  </Grid>
</UserControl>
