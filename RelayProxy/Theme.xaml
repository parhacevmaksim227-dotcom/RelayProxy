<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:RelayProxy.Desktop">
  <motion:ApplicationIcon x:Key="AppIcon"/>
  <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="UiText">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Palette -->
  <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint=".9,1"><GradientStop Color="#1EFFFFFF" Offset="0"/><GradientStop Color="#0DFFFFFF" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="Muted" Color="#B6B6B6"/>
  <SolidColorBrush x:Key="Subtle" Color="#858585"/>
  <SolidColorBrush x:Key="Accent" Color="#A2A2A2"/>
  <SolidColorBrush x:Key="Line" Color="#1FFFFFFF"/>
  <!-- Main action buttons; the secret theme overrides these two at runtime. -->
  <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C9787878" Offset="0"/><GradientStop Color="#C4616161" Offset="1"/></LinearGradientBrush>
  <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF"/>
  <!-- Drop-down lists, tooltips and the window buttons; the secret theme recolours them too. -->
  <SolidColorBrush x:Key="PopupFill" Color="#F01B1B1B"/>
  <SolidColorBrush x:Key="TipFill" Color="#F21A1A1A"/>
  <SolidColorBrush x:Key="ChromeInk" Color="#C8C8C8"/>
  <SolidColorBrush x:Key="NavInk" Color="#A0A0A0"/>

  <!-- Line icons on a 24 grid, drawn like SF Symbols: 1.8 stroke, round caps. -->
  <Geometry x:Key="IconLink">M3.4,18 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 M15.4,6 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 M6,15.4 C6,10 18,14 18,8.6</Geometry>
  <Geometry x:Key="IconApps">M5.5,4 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z M15,4 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z M5.5,13.5 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z M15,13.5 h4 a1.5,1.5 0 0 1 1.5,1.5 v4 a1.5,1.5 0 0 1 -1.5,1.5 h-4 a1.5,1.5 0 0 1 -1.5,-1.5 v-4 a1.5,1.5 0 0 1 1.5,-1.5 z</Geometry>
  <Geometry x:Key="IconJournal">M7,3 h6.5 l5.5,5.5 v10.5 a2,2 0 0 1 -2,2 h-10 a2,2 0 0 1 -2,-2 v-14 a2,2 0 0 1 2,-2 z M13.5,3 v4.5 a1,1 0 0 0 1,1 h4.5 M8.5,13 h7 M8.5,16.5 h5</Geometry>
  <Geometry x:Key="IconSettings">M4,8 h8.5 M17.5,8 h2.5 M4,16 h2.5 M11.5,16 h8.5 M12.5,8 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0 M6.5,16 a2.5,2.5 0 1,0 5,0 a2.5,2.5 0 1,0 -5,0</Geometry>
  <Geometry x:Key="IconSearch">M10.5,4 a6.5,6.5 0 1,0 0,13 a6.5,6.5 0 1,0 0,-13 z M15.3,15.3 L20,20</Geometry>
  <Geometry x:Key="IconChevron">M6,9.5 l6,6 l6,-6</Geometry>
  <Geometry x:Key="IconCheck">M5,12.5 l4.5,4.5 l9.5,-10</Geometry>
  <Geometry x:Key="IconPlus">M12,5 v14 M5,12 h14</Geometry>
  <Geometry x:Key="IconTrash">M4.5,7 h15 M9.5,7 v-2 a1,1 0 0 1 1,-1 h3 a1,1 0 0 1 1,1 v2 M6.5,7 l.9,12 a1.5,1.5 0 0 0 1.5,1.4 h6.2 a1.5,1.5 0 0 0 1.5,-1.4 l.9,-12 M10,11 v5.5 M14,11 v5.5</Geometry>
  <Geometry x:Key="IconClipboard">M8.5,5 H7 a2,2 0 0 0 -2,2 v12 a2,2 0 0 0 2,2 h10 a2,2 0 0 0 2,-2 V7 a2,2 0 0 0 -2,-2 h-1.5 M9.5,3 h5 a1,1 0 0 1 1,1 v2 a1,1 0 0 1 -1,1 h-5 a1,1 0 0 1 -1,-1 v-2 a1,1 0 0 1 1,-1 z</Geometry>
  <Geometry x:Key="IconArrow">M5,12 h14 M13.5,6.5 l5.5,5.5 l-5.5,5.5</Geometry>

  <Geometry x:Key="IconWindow">M6.5,5 H17.5 a2.5,2.5 0 0 1 2.5,2.5 V16.5 a2.5,2.5 0 0 1 -2.5,2.5 H6.5 a2.5,2.5 0 0 1 -2.5,-2.5 V7.5 a2.5,2.5 0 0 1 2.5,-2.5 z M4,9.5 H20</Geometry>
  <Geometry x:Key="IconPower">M7.2,6.6 a7.5,7.5 0 1 0 9.6,0 M12,3.5 V11.5</Geometry>
  <Geometry x:Key="IconCross">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</Geometry>
  <Geometry x:Key="IconGlobe">M12,3.5 a8.5,8.5 0 1 0 0.01,0 z M3.8,12 H20.2 M12,3.5 C8.6,7.2 8.6,16.8 12,20.5 M12,3.5 C15.4,7.2 15.4,16.8 12,20.5</Geometry>
  <Geometry x:Key="IconHeart">M12,19.5 C5.5,15 3.5,11.5 3.5,8.8 A4.3,4.3 0 0 1 12,7.2 A4.3,4.3 0 0 1 20.5,8.8 C20.5,11.5 18.5,15 12,19.5 Z</Geometry>
  <Style x:Key="Icon" TargetType="ContentControl">
    <Setter Property="Width" Value="20"/><Setter Property="Height" Value="20"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
      <Viewbox><Canvas Width="24" Height="24"><Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="Window"><Setter Property="Background" Value="#0F0F0F"/><Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="14"/><Setter Property="UseLayoutRounding" Value="True"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="2,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#400B0B0B"/><Setter Property="CornerRadius" Value="28"/><Setter Property="Padding" Value="26"/><Setter Property="motion:GlassMotion.Stage" Value="True"/></Style>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="#EFEFEF"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
      <Border Background="{DynamicResource TipFill}" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="11" Padding="11,7" Margin="0,0,10,12"><Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity=".4" Color="#070707"/></Border.Effect><ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="#330D0D0D"/><Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="CaretBrush" Value="#BABABA"/><Setter Property="SelectionBrush" Value="#66BABABA"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Frame" Background="#330D0D0D" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="15"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E6BABABA" Duration="0:0:0.22"><ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction></ColorAnimation><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#4D131313" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#26FFFFFF" Duration="0:0:0.3"><ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction></ColorAnimation><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#330D0D0D" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Plain" TargetType="TextBox">
    <Setter Property="Foreground" Value="#E0E0E0"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="CaretBrush" Value="#BABABA"/><Setter Property="SelectionBrush" Value="#66BABABA"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
    <Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="Padding" Value="14,11"/><Setter Property="FontSize" Value="14"/><Setter Property="CaretBrush" Value="#BABABA"/><Setter Property="SelectionBrush" Value="#66BABABA"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
      <Border x:Name="Frame" Background="#330D0D0D" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="15"><ScrollViewer x:Name="PART_ContentHost" Focusable="False"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocusWithin" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#E6BABABA" Duration="0:0:0.22"><ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction></ColorAnimation><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#4D131313" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#26FFFFFF" Duration="0:0:0.3"><ColorAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ColorAnimation.EasingFunction></ColorAnimation><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#330D0D0D" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Background" Value="#12FFFFFF"/><Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="Padding" Value="20,10"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="motion:GlassMotion.Interactive" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <motion:LiquidGlass x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="22" MinHeight="40">
        <Grid>
          <Border x:Name="Shine" CornerRadius="22" Background="#1EFFFFFF" Opacity="0" IsHitTestVisible="False"/>
          <Border x:Name="Focus" CornerRadius="22" BorderBrush="#E6BABABA" BorderThickness="1.6" Opacity="0" IsHitTestVisible="False"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Grid>
      </motion:LiquidGlass>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.38"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WindowButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource ChromeInk}"/><Setter Property="Width" Value="42"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="2,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Pad" Background="#00FFFFFF" CornerRadius="16"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pad" Property="Background" Value="#24FFFFFF"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Pad" Property="Background" Value="#3CFFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Chip" TargetType="Button">
    <Setter Property="Foreground" Value="#E4E4E6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Plate" Background="#18FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="16" Padding="8,5,12,5" RenderTransformOrigin=".5,.5">
        <Border.RenderTransform><ScaleTransform x:Name="Press" ScaleX="1" ScaleY="1"/></Border.RenderTransform><ContentPresenter VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#30FFFFFF" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Plate" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#18FFFFFF" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To=".96" Duration="0:0:0.09"/><DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To=".94" Duration="0:0:0.09"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="6"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="6"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Plate" Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
    <Setter Property="Background" Value="{DynamicResource PrimaryFill}"/>
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#E5E5E5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,6"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="Box" Width="21" Height="21" CornerRadius="7" Background="#22FFFFFF" BorderBrush="#66C5C5C5" BorderThickness="1.2" VerticalAlignment="Center">
          <Viewbox x:Name="Tick" Width="13" Height="13" Opacity="0" RenderTransformOrigin=".5,.5"><Viewbox.RenderTransform><ScaleTransform x:Name="TickScale" ScaleX=".5" ScaleY=".5"/></Viewbox.RenderTransform><Canvas Width="24" Height="24"><Path Data="{StaticResource IconCheck}" Stroke="#1F1F1F" StrokeThickness="3.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
        </Border>
        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#BABABA" Duration="0:0:0.22"/>
            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#BABABA" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
            <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.42"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.42"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.7"/></DoubleAnimation.EasingFunction></DoubleAnimation>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#22FFFFFF" Duration="0:0:0.2"/>
            <ColorAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#66C5C5C5" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
            <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX" To=".5" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY" To=".5" Duration="0:0:0.15"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Toggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
    <Setter Property="motion:GlassMotion.SmoothToggle" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid Width="52" Height="32" Background="Transparent">
        <Border x:Name="Track" Width="52" Height="32" Background="#474747" CornerRadius="16" Padding="2" BorderThickness="0">
          <Ellipse x:Name="Knob" Width="28" Height="28" Fill="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left"><Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity=".32" Color="#070707"/></Ellipse.Effect></Ellipse>
        </Border>
        <Border CornerRadius="16" BorderThickness="1" BorderBrush="#24FFFFFF" IsHitTestVisible="False"/>
        <Border x:Name="Focus" CornerRadius="16" BorderThickness="2" BorderBrush="#E6BABABA" IsHitTestVisible="False" Opacity="0"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style x:Key="Nav" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource NavInk}"/><Setter Property="Padding" Value="18,0"/><Setter Property="Height" Value="45"/><Setter Property="Margin" Value="0,3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="motion:GlassMotion.Interactive" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Frame" Background="#00FFFFFF" CornerRadius="22" Padding="{TemplateBinding Padding}">
        <ContentPresenter x:Name="Content" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#DDDDDD"/>
          <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#14FFFFFF" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#00FFFFFF" Duration="0:0:0.32"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="Padding" Value="14,10"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
      <Border x:Name="Frame" Background="#00FFFFFF" CornerRadius="11" Padding="{TemplateBinding Padding}" Margin="0,1"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Frame" Property="Background" Value="#1FFFFFFF"/></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="#33BABABA"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="Padding" Value="14,11"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton x:Name="Button" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Frame" Background="#330D0D0D" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="15">
              <Viewbox Width="15" Height="15" HorizontalAlignment="Right" Margin="0,0,14,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconChevron}" Stroke="#B6B6B6" StrokeThickness="2.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#44FFFFFF"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E6BABABA"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" Margin="14,11,38,11" VerticalAlignment="Center"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" HorizontalOffset="-14" VerticalOffset="-2" AllowsTransparency="True" Focusable="False" PopupAnimation="None">
          <Border x:Name="Pop" Margin="14,4,14,26" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource PopupFill}" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="18" Padding="6" RenderTransformOrigin=".5,0">
            <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="10" Opacity=".5" Color="#070707"/></Border.Effect>
            <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Border.Triggers><EventTrigger RoutedEvent="FrameworkElement.Loaded"><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From=".88" To="1" Duration="0:0:0.38"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From=".96" To="1" Duration="0:0:0.38"><DoubleAnimation.EasingFunction><QuinticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard></BeginStoryboard></EventTrigger></Border.Triggers>
            <ScrollViewer><ItemsPresenter/></ScrollViewer>
          </Border>
        </Popup>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ListBox"><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border x:Name="ListSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True"><ScrollViewer motion:SmoothScroll.Enabled="True" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" Focusable="False" Padding="{TemplateBinding Padding}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Frame" Background="#3A141414" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="20" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#4A232323" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3A141414" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#99BABABA" Duration="0:0:0.22"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#24FFFFFF" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
        <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Bar" Background="#3DFFFFFF" CornerRadius="5" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bar" Property="Background" Value="#66FFFFFF"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Bar" Property="Background" Value="#80FFFFFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track>
      <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>
